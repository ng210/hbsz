<UserControl x:Class="CardGame.Controls.GalleryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CardGame.Controls"
             mc:Ignorable="d"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             d:DesignWidth="640" d:DesignHeight="480">
    <Grid Background="LightGreen">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80px" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="80px" />
        </Grid.ColumnDefinitions>
        <Button Grid.Row="1" Grid.Column="0" Height="32px" Margin="8px" Click="Previous_Click">Vissza</Button>
        <local:CardControl x:Name="Card" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Button Grid.Row="1" Grid.Column="2" Height="32px" Margin="8px" Click="Next_Click">Előre</Button>
    </Grid>
</UserControl>
